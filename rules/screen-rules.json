{
  "schema": 3,
  "rulesVersion": "2026-10-31.2",
  "date": "2026-10-31",
  "apps": [
    {
      "id": "youtube",
      "package": "com.google.android.youtube",
      "name": "YouTube",
      "feedName": "YouTube Shorts",
      "surfaces": [
        {
          "id": "shorts",
          "match": {
            "any": [
              { "node": { "id": "reel_watch_player", "minHeight": 0.6 } },
              { "node": { "id": "reel_player_page_container", "minHeight": 0.6 } }
            ]
          },
          "exclude": [],
          "otherTab": { "parentId": "pivot_bar", "child": "firstClickable" }
        }
      ],
      "verifiedOn": [
        {
          "device": "Pixel, Android 17",
          "android": "17",
          "appVersionName": "not recorded",
          "appVersionCode": 0,
          "date": "2026-10-29",
          "how": "uiautomator dumps, sanitised into tests/fixtures/youtube/"
        }
      ]
    },
    {
      "id": "instagram",
      "package": "com.instagram.android",
      "name": "Instagram",
      "feedName": "Instagram Reels",
      "surfaces": [
        {
          "id": "reels",
          "match": {
            "all": [
              { "node": { "id": "clips_viewer_view_pager", "minHeight": 0.6 } },
              {
                "any": [
                  { "node": { "id": "clips_single_media_component", "minHeight": 0.6 } },
                  { "node": { "id": "clips_tab", "selected": true } }
                ]
              }
            ]
          },
          "exclude": [
            { "node": { "id": "reel_viewer_root" } },
            { "node": { "id": "direct_inbox_action_bar" } },
            { "node": { "id": "inbox_refreshable_thread_list_recyclerview" } },
            { "node": { "id": "message_thread_container" } },
            { "node": { "id": "row_thread_composer_container" } }
          ],
          "otherTab": { "parentId": "tab_bar", "child": "firstClickable" }
        }
      ],
      "verifiedOn": [
        {
          "device": "Pixel, Android 17",
          "android": "17",
          "appVersionName": "453.0.0.57.79",
          "appVersionCode": 385914557,
          "date": "2026-10-30",
          "how": "uiautomator dumps, sanitised into tests/fixtures/instagram/"
        }
      ]
    },
    {
      "id": "x",
      "package": "com.twitter.android",
      "name": "X",
      "feedName": "the X video feed",
      "surfaces": [
        {
          "id": "video-viewer",
          "match": { "tag": { "id": "VideoTab", "minHeight": 0.8 } },
          "exclude": [
            { "tag": { "id": "MediaGallery" } },
            { "tag": { "id": "PostDetail" } }
          ]
        }
      ],
      "verifiedOn": [
        {
          "device": "Pixel, Android 17",
          "android": "17",
          "appVersionName": "12.38.1-prod.01",
          "appVersionCode": 312381001,
          "date": "2026-10-31",
          "how": "uiautomator dumps, sanitised into tests/fixtures/x/"
        }
      ]
    },
    {
      "id": "ytmusic",
      "package": "com.google.android.apps.youtube.music",
      "name": "YouTube Music",
      "feedName": "YouTube Music Samples",
      "surfaces": [
        {
          "id": "samples",
          "match": {
            "any": [
              { "node": { "id": "reel_recycler", "minHeight": 0.6 } },
              { "node": { "id": "reel_watch_player", "minHeight": 0.6 } },
              { "node": { "id": "reel_player_page_container", "minHeight": 0.6 } }
            ]
          },
          "exclude": [
            { "node": { "id": "player_page", "minHeight": 0.9 } }
          ],
          "otherTab": { "parentId": "pivot_bar", "child": "first" },
          "leave": "otherTabFirst"
        }
      ],
      "verifiedOn": [
        {
          "device": "Pixel, Android 17",
          "android": "17",
          "appVersionName": "9.43.51",
          "appVersionCode": 94351240,
          "date": "2026-10-31",
          "how": "uiautomator dumps, sanitised into tests/fixtures/ytmusic/"
        }
      ]
    }
  ]
}
