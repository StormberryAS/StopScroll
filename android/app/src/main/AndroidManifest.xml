<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      NO PERMISSIONS AT ALL (spec 8; AP-2 at its default, b). The Accessibility Service below is
      protected by android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE", which only the
      system holds; the app does not ask for it. android/expected-permissions.txt holds the package
      line only, and both the Gradle task check<Variant>MergedManifest and android/tools/check-apk.sh
      fail on any permission in the merged manifest or the APK.

      NO INTERNET. The privacy claim ("no server calls") rests on this line: removed explicitly, in
      case a library ever merges it in. Links open in other apps through ACTION_VIEW, which needs no
      INTERNET, and only from the fixed list in LinkList.kt.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- androidx.core's private permission for its registerReceiver shim, which StopScroll never
         uses (the screen-off receiver is registered with the platform call): removed, as in the
         Labs template (spec 6.6). -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- The installed version of the watched app, for the health line (spec 6.8). One package,
         no QUERY_ALL_PACKAGES. -->
    <queries>
        <package android:name="com.google.android.youtube" />
    </queries>

    <!-- NO BACKUP: allowBackup false, and both rule files exclude everything as well, because
         device-to-device transfer is not governed by allowBackup. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StopScroll">

        <!-- No usage metrics to Google, and nothing for Safe Browsing to protect: the WebView loads
             only the bundled page and the app has no network. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:configChanges="mcc|mnc|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection|fontWeightAdjustment|grammaticalGender|colorMode|touchscreen"
            android:theme="@style/Theme.StopScroll">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The Accessibility Service (spec 6.1). Exported so the system can bind it, and protected by
          BIND_ACCESSIBILITY_SERVICE, which only the system holds. Its configuration, with the one
          watched package, is res/xml/accessibility_service_config.xml.
        -->
        <service
            android:name=".FeedService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- androidx.profileinstaller's receiver for adb and benchmarking tools: not needed. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>

</manifest>
