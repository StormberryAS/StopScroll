<?xml version="1.0" encoding="utf-8"?>
<!-- API 31 and above. Nothing leaves the phone, by cloud backup or by device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="device_root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="device_root" />
    </device-transfer>
</data-extraction-rules>
