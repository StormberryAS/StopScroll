<?xml version="1.0" encoding="utf-8"?>
<!--
  StopScroll's Accessibility Service, stage 1 part one (spec 6.1, with the 2026-10-29 build scope:
  YouTube only; Instagram waits for its captures, Facebook for stage 2).

  packageNames: ONLY the apps this build watches, and never empty: an empty list means every app.
    When no app is on or consent is missing, FeedService keeps this list and sets the event types
    to 0 instead (ServiceConfig.kt, review B1).
  notificationTimeout 0: a value above 0 only delays every event (AOSP notifyAccessibilityEvent);
    FeedService throttles content changes itself.
  canRetrieveWindowContent and flagReportViewIds: Shorts opens inside YouTube's main activity, so
    only the view IDs tell it apart.
  isAccessibilityTool false, always: StopScroll is not an accessibility tool.
  Not requested: interactive windows, not-important views, gestures, screenshots, key events.
  tests/guards.test.ts pins every attribute here.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:packageNames="com.google.android.youtube"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0"
    android:isAccessibilityTool="false"
    android:settingsActivity="no.stormberry.stopscroll.MainActivity"
    android:description="@string/service_description" />
